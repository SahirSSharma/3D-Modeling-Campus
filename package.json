{
  "name": "3d-modeling-campus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A walk across a real campus, built from aerial LiDAR and OpenStreetMap.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:osm": "node scripts/build-campus-3d.mjs",
    "build:lidar": "node scripts/build-campus-lidar.mjs",
    "build:arcgis": "node scripts/build-campus-arcgis.mjs",
    "build:colors": "node scripts/build-campus-colors.mjs",
    "build:satellite": "node scripts/build-campus-satellite.mjs",
    "build:satellite:apple": "node scripts/build-campus-satellite.mjs --source=apple",
    "build:truecolor": "node scripts/build-campus-truecolor.mjs",
    "build:markings": "node scripts/build-campus-markings.mjs",
    "build:region": "node scripts/build-region.mjs",
    "build:region:terrain": "node scripts/build-region-terrain.mjs",
    "build:region:osm": "node scripts/build-region-osm.mjs",
    "build:region:heights": "node scripts/build-region-heights.mjs",
    "build:region:colors": "node scripts/build-region-colors.mjs",
    "audit:imagery": "node scripts/audit-imagery-source.mjs",
    "verify:boot": "node scripts/verify-boot.mjs",
    "verify:reproducible": "node scripts/build-campus-lidar.mjs --verify",
    "check": "node scripts/build-campus-3d.mjs --check && node scripts/build-campus-lidar.mjs --check && node scripts/build-campus-satellite.mjs --check && node scripts/build-campus-colors.mjs --check && node scripts/build-campus-colleges.mjs --check && node scripts/build-campus-lidar.mjs --verify",
    "progress": "node scripts/gauntlet-progress.mjs --print",
    "serve": "node scripts/serve.mjs",
    "readiness": "node scripts/readiness.mjs"
  },
  "devDependencies": {
    "laz-perf": "^0.0.7",
    "@playwright/test": "^1.48.0",
    "sharp": "^0.35.3"
  }
}
