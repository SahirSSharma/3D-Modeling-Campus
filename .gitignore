node_modules/
.DS_Store
*.log
.env
.env.*
.cache/

# Apple imagery is licensed and stays out of the repo — only numbers derived from it are
# committed (see scripts/reports/imagery/FINDINGS.md). Google probe renders are tracked.
scripts/reports/imagery/*-apple-probe.png

# Gauntlet run artifacts: raw agent transcripts are large and regenerable.
# STATUS.md / FINDINGS.md / shards.json stay tracked as evidence.
gauntlet-loop/runs/*/*.log
gauntlet-loop/runs/*/*.prompt.md
gauntlet-loop/runs/latest
gauntlet-loop/.no-push

# Machine-local: symlinks into ~/.claude, and Claude Code worktrees.
.claude/

# Claude Code session trail (local, feeds /recap)
.claude/session-log.jsonl
.claude/.keep-going-*

# visual-audit working screenshots — harness output, not source
audit/

# College source libraries — local-only research corpora (PDFs, renders, notes)
Eighth-College-Sources/
Revelle-College-Sources/
